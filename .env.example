# =====================================================================
# Configuração da Dona — copie este arquivo para `.env` e preencha.
# NUNCA comite o arquivo `.env` (ele está no .gitignore).
# =====================================================================

# --- Cérebro (OpenAI) -------------------------------------------------
# Chave de API da OpenAI. É SEPARADA do ChatGPT Plus: ative billing em
# https://platform.openai.com/ e gere uma chave.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo usado para raciocínio (extração, priorização, rascunhos).
OPENAI_MODEL=gpt-4o

# --- Interface (Telegram) --------------------------------------------
# Crie um bot com o @BotFather no Telegram e cole o token aqui.
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Seu chat id pessoal (a Dona só conversa com você). Descubra com /start
# após subir o bot; o id aparece no log. Deixe vazio até saber.
TELEGRAM_OWNER_CHAT_ID=

# --- Geral ------------------------------------------------------------
# Fuso horário para briefings e lembretes.
DONA_TIMEZONE=America/Sao_Paulo
# Caminho do banco SQLite.
DONA_DB_PATH=data/dona.db
# Nível de log: DEBUG, INFO, WARNING, ERROR
DONA_LOG_LEVEL=INFO

# --- E-mail (Fase 1) -------------------------------------------------
# Qual backend usar: 'imap' (Plano B), 'graph' (Plano A) ou 'both'.
EMAIL_BACKEND=imap
# Intervalo de busca de e-mails (minutos) e quantos considerar por vez.
EMAIL_POLL_MINUTES=10
EMAIL_FETCH_LIMIT=30
# Hora local (0-23) do briefing diário e do recap de fim de dia.
BRIEFING_HOUR=7
RECAP_HOUR=18

# --- E-mail (Plano B: IMAP) ------------------------------------------
# Caixa dedicada que recebe as cópias encaminhadas do Outlook.
# Deixe vazio enquanto não usar.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Pasta de enviados (ex.: 'Sent', '[Gmail]/Sent Mail'). Vazio = não ler enviados.
IMAP_SENT_FOLDER=

# --- Microsoft Graph (Plano A: opcional) -----------------------------
# Só preencha se for testar o acesso via Graph (delegado, só leitura).
# Registre um app em https://entra.microsoft.com (Azure AD), tipo "public
# client / mobile & desktop", com a permissão delegada Mail.Read.
MS_GRAPH_CLIENT_ID=
# 'common' funciona para a maioria; use o tenant id se a TI exigir.
MS_GRAPH_TENANT_ID=common

# --- Calendário (Fase 2) ---------------------------------------------
# URL do ICS publicado do seu calendário do Outlook (read-only). No Outlook
# web: Configurações > Calendário > Calendários compartilhados > Publicar.
# Deixe vazio enquanto não usar.
CALENDAR_ICS_URL=

# --- WhatsApp (Fase 3, opcional) -------------------------------------
# Módulo SOMENTE LEITURA (nunca envia), via aparelho vinculado (mesmo número).
# O sidecar fica em dona/ingest/whatsapp/ — veja o README de lá para parear.
# Esta flag é só um lembrete/documentação; o sidecar é iniciado à parte
# (ex.: docker compose --profile whatsapp up).
WHATSAPP_ENABLED=false
