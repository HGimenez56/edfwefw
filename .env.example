# =====================================================================
# Configuração da Dona — copie este arquivo para `.env` e preencha.
# NUNCA comite o arquivo `.env` (ele está no .gitignore).
# =====================================================================

# --- Cérebro (OpenAI) -------------------------------------------------
# Chave de API da OpenAI. É SEPARADA do ChatGPT Plus: ative billing em
# https://platform.openai.com/ e gere uma chave.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modelo usado para raciocínio (extração, priorização, rascunhos).
OPENAI_MODEL=gpt-4o

# --- Interface (Telegram) --------------------------------------------
# Crie um bot com o @BotFather no Telegram e cole o token aqui.
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Seu chat id pessoal (a Dona só conversa com você). Descubra com /start
# após subir o bot; o id aparece no log. Deixe vazio até saber.
TELEGRAM_OWNER_CHAT_ID=

# --- Geral ------------------------------------------------------------
# Fuso horário para briefings e lembretes.
DONA_TIMEZONE=America/Sao_Paulo
# Caminho do banco SQLite.
DONA_DB_PATH=data/dona.db
# Nível de log: DEBUG, INFO, WARNING, ERROR
DONA_LOG_LEVEL=INFO

# --- E-mail (Fase 1, Plano B: IMAP) ----------------------------------
# Caixa dedicada que recebe as cópias encaminhadas do Outlook.
# Deixe vazio enquanto não usar.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# --- Microsoft Graph (Fase 1, Plano A: opcional) ----------------------
# Só preencha se for testar o acesso via Graph (delegado, só leitura).
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=

# --- WhatsApp (Fase 3, opcional) -------------------------------------
# Liga/desliga o módulo de WhatsApp (somente leitura).
WHATSAPP_ENABLED=false
